[node name="Instructions" type="Label" parent="CanvasLayer/HelpOverlay/CenterContainer/Panel/Content" unique_id=1179560349]
custom_minimum_size = Vector2(500, 190)
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.88, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 22
text = "Move with WASD or arrow keys.
Fly through the center of air rings to refill your air.
Pass completely through a ring to earn air and build your combo.
Avoid stop signs and make sure to always have air, or else you lose!
Collect powerups for a boost, double score, or max air.
Your score increases for as long as you stay in the air."
autowrap_mode = 2

